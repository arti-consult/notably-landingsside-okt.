# Kopier denne filen til .env ved behov. Ingen variabler er påkrevd for å bygge siden.

# Optional: Override canonical site URL used in sitemap/indexing scripts
SITEMAP_BASE_URL=https://notably.no

# Optional: IndexNow for automatic URL submission after deploy/build
INDEXNOW_KEY=your-indexnow-key
INDEXNOW_HOST=notably.no
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

