{
  "redirects": [
    { "source": "/blog", "destination": "/artikler", "permanent": true },
    { "source": "/blog/:slug*", "destination": "/artikler/:slug*", "permanent": true },
    { "source": "/blogg", "destination": "/artikler", "permanent": true },
    { "source": "/blogg/:slug*", "destination": "/artikler/:slug*", "permanent": true },
    { "source": "/advokater", "destination": "/advokat", "permanent": true },
    { "source": "/regnskapsforere", "destination": "/regnskapsforer", "permanent": true },
    { "source": "/regnskapsbyra", "destination": "/regnskapsforer", "permanent": true },
    { "source": "/bygg", "destination": "/bygg-og-anlegg", "permanent": true },
    { "source": "/entreprenor", "destination": "/bygg-og-anlegg", "permanent": true },
    { "source": "/byggebransjen", "destination": "/bygg-og-anlegg", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=31536000" }]
    },
    {
      "source": "/logos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
